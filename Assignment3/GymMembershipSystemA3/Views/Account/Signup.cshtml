@{
    ViewData["Title"] = "Sign Up";
}

<h1>Create Your Gym Account</h1>

<p>Register to become a member of our gym.</p>

<form asp-controller="Account"
      asp-action="Signup"
      method="post"
      onsubmit="return validateSignup()">

    <p>
        <label>
            Full Name:
            <input type="text"
                   name="fullname"
                   id="fullname"
                   required>
        </label>
    </p>

    <p>
        <label>
            Phone Number:
            <input type="tel"
                   name="phone"
                   id="phone"
                   required>
        </label>
    </p>

    <p>
        <label>
            Email:
            <input type="email"
                   name="email"
                   id="email"
                   required>
        </label>
    </p>

    <p>
        <label>
            Password:
            <input type="password"
                   name="password"
                   id="password"
                   required>
        </label>
    </p>

    <input type="submit"
           value="Sign Up"
           class="gymButton">

    <p id="signupMessage"></p>

    @if (ViewBag.Message != null)
    {
        <p style="color: orange;">@ViewBag.Message</p>
    }

</form>

<h2>Cardio Training Area</h2>

<p>Discover our modern cardio equipment.</p>

<img src="/images/gym-cardio.png"
     alt="Cardio Training Area"
     class="gym-photo"
     usemap="#gymmap">

<map name="gymmap">
    <area shape="default"
          href="@Url.Action("About", "Home")"
          alt="About Our Gym">
</map>