@{
    ViewData["Title"] = "About Us";
}

<h1>About Our Gym</h1>

<p>
    Our gym provides fitness equipment, training facilities,
    and membership plans for our members.
</p>

<p>
    <a href="#facilities">View Our Facilities</a>
</p>

<article>
    <h2>Why Choose Our Gym?</h2>

    <p>
        Our gym provides a comfortable environment
        for fitness and strength training.
    </p>
</article>

<section id="facilities">
    <h2>Our Facilities</h2>

    <ul>
        <li>Cardio Machines</li>
        <li>Weight Training Area</li>
        <li>Locker Rooms</li>
        <li>Personal Training</li>
        <li>Showers</li>
    </ul>
</section>

<h2>Weight Training Area</h2>

<p>Explore our strength training equipment.</p>

<img src="/images/gym-weights.png"
     alt="Weight Training Area"
     class="gym-photo"
     usemap="#gymmap">

<map name="gymmap">
    <area shape="default"
          href="@Url.Action("About", "Home")"
          alt="About Our Gym">
</map>

<section>
    <h2>Why Choose Our Gym?</h2>

    <p id="gymBenefitText">
        Discover what makes our gym special.
    </p>

    <button type="button"
            class="gymButton"
            onclick="showGymBenefits()">
        Show Gym Benefits
    </button>
</section>