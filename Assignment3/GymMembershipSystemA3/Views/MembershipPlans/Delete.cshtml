@model GymMembershipSystemA3.Models.MembershipPlan

@{
    ViewData["Title"] = "Delete Membership Plan";
}

<h1>Delete Membership Plan</h1>

<p>Are you sure you want to delete this membership plan?</p>

<div style="margin: 25px 0;">

    <h2>Plan Details</h2>

    <p>
        <strong>Plan Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Duration:</strong>
        @Model.DurationMonths Months
    </p>

    <p>
        <strong>Price:</strong>
        @Model.Price.ToString("0.##") SAR
    </p>

</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit"
            style="background-color: red; color: white; padding: 12px 20px; border: none; border-radius: 8px; cursor: pointer;">
        Confirm Delete
    </button>

    <a asp-action="Index" style="margin-left: 15px;">
        Cancel
    </a>

</form>