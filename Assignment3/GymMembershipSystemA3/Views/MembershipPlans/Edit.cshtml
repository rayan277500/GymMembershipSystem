@model GymMembershipSystemA3.Models.MembershipPlan

@{
    ViewData["Title"] = "Edit Membership Plan";
}

<h1>Edit Membership Plan</h1>

<p>Update the details of your gym membership plan.</p>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" style="max-width: 500px;">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All" style="color: red;"></div>

    <div style="margin-bottom: 20px;">
        <label asp-for="Name">Plan Name</label>

        <input asp-for="Name"
               type="text"
               required
               style="display: block; width: 100%; padding: 10px; margin-top: 8px;" />

        <span asp-validation-for="Name" style="color: red;"></span>
    </div>

    <div style="margin-bottom: 20px;">
        <label asp-for="DurationMonths">Duration (Months)</label>

        <input asp-for="DurationMonths"
               type="number"
               min="1"
               required
               style="display: block; width: 100%; padding: 10px; margin-top: 8px;" />

        <span asp-validation-for="DurationMonths" style="color: red;"></span>
    </div>

    <div style="margin-bottom: 20px;">
        <label asp-for="Price">Price (SAR)</label>

        <input asp-for="Price"
               type="number"
               min="0.01"
               step="0.01"
               required
               style="display: block; width: 100%; padding: 10px; margin-top: 8px;" />

        <span asp-validation-for="Price" style="color: red;"></span>
    </div>

    <button type="submit"
            style="background-color: orange; color: black; padding: 12px 20px; border: none; border-radius: 8px; cursor: pointer;">
        Save Changes
    </button>

    <a asp-action="Index" style="margin-left: 15px;">
        Back to Plans
    </a>

</form>